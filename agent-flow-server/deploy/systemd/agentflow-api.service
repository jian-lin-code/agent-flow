[Unit]
Description=AgentFlow API (FastAPI / uvicorn)
After=network-online.target redis-server.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=agentflow
Group=agentflow
WorkingDirectory=/opt/agentflow/agent-flow-server
EnvironmentFile=/opt/agentflow/agent-flow-server/.env
ExecStart=/opt/agentflow/agent-flow-server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port ${APP_PORT}
Restart=always
RestartSec=3
# 优雅退出：给正在处理的工作流留出时间
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/agentflow/api.log
StandardError=append:/var/log/agentflow/api.err.log

[Install]
WantedBy=multi-user.target
